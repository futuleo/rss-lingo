  "faq": {
    "title": "الأسئلة الشائعة",
    "sections": [
      {
        "title": "حول",
        "items": [
          {
            "q": "ما هو RSS Lingo؟",
            "a": "RSS Lingo هو قارئ RSS للهاتف يساعدك على تعلّم لغة. أضف الموجزات التي تهمك، واقرأ براحة، وترجم المقالات بمفتاح الذكاء الاصطناعي الخاص بك. كل شيء يُحفظ على جهازك."
          }
        ]
      },
      {
        "title": "الموجزات",
        "items": [
          {
            "q": "كيف أضيف موجزًا؟",
            "a": "اضغط على + إضافة موجز والصق رابط RSS مباشر مثل https://example.org/rss.xml. يُجلب الموجز فورًا."
          },
          {
            "q": "أين أجد رابط RSS؟",
            "a": "ابحث عن رابط \"RSS\" أو \"Feed\" في تذييل الموقع أو ترويسته. يمكنك أيضًا تجربة /rss.xml أو /feed/ أو /atom.xml. لصق عنوان الموقع وحده غير مدعوم بعد — الاكتشاف التلقائي مخطط له."
          }
        ]
      },
      {
        "title": "القراءة",
        "items": [
          {
            "q": "ماذا يفعل حفظ؟",
            "a": "يحفظ المقال إلى الأبد. بدون الحفظ، يُحتفظ فقط بأحدث 50 مقالًا لكل موجز."
          },
          {
            "q": "أين تُخزن المقالات؟",
            "a": "تعيش المقالات في قاعدة بيانات محلية على جهازك فقط."
          }
        ]
      },
      {
        "title": "إعداد الترجمة (BYOK)",
        "items": [
          {
            "q": "كيف أعدّ الترجمة؟",
            "a": "افتح الإعدادات (⚙)، اختر موفرًا (OpenAI أو Anthropic أو Gemini أو DeepSeek)، وأدخل اسم النموذج (مثل gpt-4o-mini أو claude-sonnet-4-5 أو gemini-2.0-flash أو deepseek-chat)، والصق مفتاح API الخاص بك من ذلك الموفر (احصل عليه من platform.openai.com أو console.anthropic.com أو aistudio.google.com)، واختر اللغة الهدف ثم اضغط اختبار الاتصال."
          }
        ]
      },
      {
        "title": "المفتاح والخصوصية",
        "items": [
          {
            "q": "أين يُخزن مفتاح API الخاص بي؟",
            "a": "يُخزن مفتاحك في التخزين الآمن للجهاز (iOS Keychain / Android Keystore). يُرسل فقط إلى الموفر الذي اخترته وفقط عند الترجمة. ليس لدينا خوادم ولا نرى مفتاحك أبدًا."
          },
          {
            "q": "هل يمكنني استخدام خدمات متوافقة مع OpenAI؟",
            "a": "نعم. عيّن عنوان URL أساسي مخصصًا في الإعدادات لخدمات مثل OpenRouter أو Groq أو النماذج المحلية."
          }
        ]
      },
      {
        "title": "استكشاف الأخطاء وإصلاحها",
        "items": [
          {
            "q": "\"مفتاح API غير صالح\"",
            "a": "أعد التحقق من المفتاح في الإعدادات."
          },
          {
            "q": "\"تم تجاوز حد الطلبات\"",
            "a": "انتظر لحظة ثم أعد المحاولة."
          },
          {
            "q": "\"انتهت المهلة\"",
            "a": "تحقق من اتصالك بالإنترنت."
          },
          {
            "q": "\"اضبط أولاً\"",
            "a": "افتح الإعدادات وأضف موفر ذكاء اصطناعي ومفتاح API."
          },
          {
            "q": "الترجمة تظهر بلغة خاطئة",
            "a": "تحقق من اللغة الهدف في الإعدادات."
          }
        ]
      },
      {
        "title": "اللغات",
        "items": [
          {
            "q": "ما اللغات التي يدعمها التطبيق؟",
            "a": "تتبع واجهة التطبيق لغة الترجمة الهدف التي تختارها في الإعدادات (الألمانية، الإسبانية، الإنجليزية، الإيطالية، البرتغالية، الروسية، الصينية المبسطة، العربية، الفنلندية، الفرنسية، الكورية، الهندية، أو اليابانية)."
          }
        ]
      }
    ]
  }
